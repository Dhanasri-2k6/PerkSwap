# PerkSwap Environment Configuration

# MongoDB Connection String
MONGODB_URI="mongodb://localhost:27017/perkswap"

# Authentication & Cryptography
JWT_SECRET="your_jwt_secret_here"
ENCRYPTION_KEY="your_encryption_key_here"
AES_SECRET_KEY="your_aes_secret_key_here"

# Google Gemini API Key
GEMINI_API_KEY=""

# Platform & Escrow Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ESCROW_FEE_PERCENT="5"
ESCROW_INSPECTION_HOURS="2"

# Razorpay Payment Gateway (TEST MODE ONLY - keys MUST start with rzp_test_)
# Never commit real credentials or use rzp_live_ keys
RAZORPAY_KEY_ID="rzp_test_your_test_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_test_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_test_webhook_secret_here"
